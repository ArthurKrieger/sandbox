# Not a secret -- this account's own S3 bucket name (see sandbox-infra's
# environments/persistent). Needed locally so build.gradle can resolve
# dev.arthur:sandbox-messaging from S3. Not hardcoded in build.gradle
# because this project is meant to be recreated in any AWS account, and
# the bucket name is account-specific.
#
# Get the real value: cd ../sandbox-infra/environments/persistent && terraform output -raw bucket_name
MAVEN_S3_BUCKET=
